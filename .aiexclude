build/
.dart_tool/
.packages
.flutter-plugins
.flutter-plugins-dependencies
*.g.dart
*.freezed.dart
*.gr.dart

# 3. IDE and OS
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# 4. Temporary / backup
*.tmp
*.temp
*.log
*.bak
*.orig
*.swp
*.swo

# 5. macOS native build output
macos/Flutter/ephemeral/
macos/Pods/
macos/Runner.xcodeproj/project.xcworkspace/xcshareddata/
macos/Runner.xcodeproj/xcuserdata/
macos/Runner.xcworkspace/xcshareddata/

# 6. Tests output
coverage/
*.lcov

# 7. Not useful for agents
LICENSE
pubspec.lock
